<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Hadiah Ulang Tahun Untuk Om 💗</title>

<style>

/* =====================================================
   RESET
===================================================== */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}


/* =====================================================
   BODY
===================================================== */

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;

    background:
        linear-gradient(
            135deg,
            #ff9ecf,
            #d59aff,
            #ffb6dc
        );

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: hidden;
}


/* =====================================================
   SPARKLE
===================================================== */

.sparkle {
    position: fixed;

    width: 4px;
    height: 4px;

    background: white;

    border-radius: 50%;

    opacity: .7;

    animation:
        twinkle 2s infinite alternate;

    pointer-events: none;

    z-index: 1;
}

@keyframes twinkle {

    from {
        opacity: .2;
        transform: scale(.7);
    }

    to {
        opacity: 1;
        transform: scale(1.5);
    }

}


/* =====================================================
   CARD
===================================================== */

.card {

    width: 92%;
    max-width: 430px;

    min-height: 550px;

    padding: 25px;

    border-radius: 30px;

    background:
        rgba(255,255,255,.25);

    backdrop-filter: blur(15px);

    -webkit-backdrop-filter: blur(15px);

    box-shadow:
        0 15px 40px rgba(0,0,0,.2);

    text-align: center;

    position: relative;

    z-index: 10;

    /*
       Boleh keluar sedikit dari card
       karena tombol nomor 2 bisa pindah
    */
    overflow: visible;
}


/* =====================================================
   SLIDE
===================================================== */

.slide {

    display: none;

    animation:
        fade .5s ease;

}

.slide.active {

    display: block;

}

@keyframes fade {

    from {

        opacity: 0;

        transform:
            scale(.9);

    }

    to {

        opacity: 1;

        transform:
            scale(1);

    }

}


/* =====================================================
   TEXT
===================================================== */

h1 {

    color: white;

    font-size: 30px;

    line-height: 1.3;

}

h2 {

    color: white;

    font-size: 25px;

    line-height: 1.3;

}

p {

    color: white;

    font-size: 17px;

    line-height: 1.6;

}


/* =====================================================
   BUTTON
===================================================== */

button {

    border: none;

    padding:
        13px 22px;

    margin:
        8px;

    border-radius: 30px;

    background: white;

    color: #d94c9b;

    font-weight: bold;

    font-size: 15px;

    cursor: pointer;

    box-shadow:
        0 5px 15px rgba(0,0,0,.15);

    transition:
        .2s;

    position: relative;

    z-index: 20;

}

button:active {

    transform:
        scale(.95);

}


/* tombol lanjut */

.next-btn {

    background:
        #ff5ca8;

    color: white;

}


/* =====================================================
   FOTO
===================================================== */

.photo-box {

    width: 100%;

    height: 220px;

    border-radius: 20px;

    background:
        rgba(255,255,255,.3);

    display: flex;

    justify-content: center;

    align-items: center;

    color: white;

    margin:
        15px 0;

    overflow: hidden;

}


/* kalau nanti pakai gambar */

.photo-box img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    border-radius: 20px;

}


/* =====================================================
   PROGRESS DOT
===================================================== */

.progress {

    position: absolute;

    bottom: 12px;

    left: 0;

    right: 0;

    display: flex;

    justify-content: center;

    gap: 5px;

    z-index: 30;

}

.dot {

    width: 7px;

    height: 7px;

    background:
        rgba(255,255,255,.5);

    border-radius: 50%;

}

.dot.active {

    background: white;

}


/* =====================================================
   MUSIC BUTTON
===================================================== */

.music-btn {

    position: fixed;

    top: 15px;

    right: 15px;

    z-index: 100000;

    padding:
        10px 15px;

    margin: 0;

    font-size: 13px;

}


/* =====================================================
   =====================================================
   NOMOR 1
   KAIL PANCING
   =====================================================
===================================================== */


/*
   Kail
*/

#hook {

    position: fixed;

    font-size: 48px;

    z-index: 99999;

    display: none;

    left: 50%;

    top: -80px;

    transform:
        translateX(-50%);

    transition:
        top .8s ease;

    pointer-events: none;

}


/*
   Benang pancing
*/

#hookLine {

    position: fixed;

    width: 3px;

    background: white;

    z-index: 99998;

    display: none;

    top: 0;

    height: 0;

    transition:
        height .8s ease;

    pointer-events: none;

}


/*
   Tombol yang kena kail
*/

.hooked {

    position: fixed !important;

    z-index: 99997 !important;

    transition:

        top 1.3s
        cubic-bezier(.4,0,.2,1),

        transform 1.3s ease,

        opacity .3s ease;

}


/* =====================================================
   =====================================================
   NOMOR 2
   TOMBOL PINDAH-PINDAH
   =====================================================
===================================================== */


/*
   Kedua tombol salah
   TETAP ADA
*/

.runaway {

    position: relative;

    z-index: 9999;

    transition:

        left .4s ease,

        top .4s ease,

        transform .4s ease;

}


/*
   Penting:
   tidak ada display:none
   di sini.
*/


/* =====================================================
   =====================================================
   NOMOR 3
   API
   =====================================================
===================================================== */

.fire-container {

    position: fixed;

    z-index: 99999;

    pointer-events: none;

    display: none;

    width: 10px;

    height: 10px;

}


/*
   Semua api
*/

.fire {

    position: absolute;

    font-size: 38px;

    opacity: 0;

}


/*
   Saat aktif
*/

.fire.active {

    opacity: 1;

    animation:
        firePop .18s infinite alternate;

}


/*
   Api bagian atas
*/

.fire:nth-child(1) {

    left: -80px;
    top: -70px;

}

.fire:nth-child(2) {

    left: -40px;
    top: -90px;

}

.fire:nth-child(3) {

    left: 0;
    top: -100px;

}

.fire:nth-child(4) {

    left: 40px;
    top: -90px;

}

.fire:nth-child(5) {

    left: 80px;
    top: -65px;

}


/*
   Api samping kiri
*/

.fire:nth-child(6) {

    left: -100px;
    top: -20px;

}

.fire:nth-child(7) {

    left: -110px;
    top: 25px;

}

.fire:nth-child(8) {

    left: -80px;
    top: 65px;

}


/*
   Api bagian bawah
*/

.fire:nth-child(9) {

    left: -40px;
    top: 85px;

}

.fire:nth-child(10) {

    left: 0;
    top: 95px;

}

.fire:nth-child(11) {

    left: 40px;
    top: 85px;

}

.fire:nth-child(12) {

    left: 80px;
    top: 60px;

}


/*
   Api kanan
*/

.fire:nth-child(13) {

    left: 105px;
    top: 20px;

}

.fire:nth-child(14) {

    left: 100px;
    top: -25px;

}


/*
   Animasi api
*/

@keyframes firePop {

    from {

        transform:
            scale(.7)
            rotate(-12deg);

    }

    to {

        transform:
            scale(1.25)
            rotate(12deg);

    }

}


/*
   Tombol sedang terbakar
*/

.burning {

    animation:
        burningButton .12s infinite alternate !important;

}


@keyframes burningButton {

    0% {

        transform:
            translateX(-5px)
            rotate(-5deg)
            scale(1);

        filter:
            brightness(1);

    }

    50% {

        transform:
            translateX(5px)
            rotate(5deg)
            scale(1.05);

        filter:
            brightness(1.4);

    }

    100% {

        transform:
            translateX(-4px)
            rotate(-4deg)
            scale(.96);

        filter:
            brightness(.8);

    }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 500px) {

    .card {

        width: 92%;

        min-height: 570px;

        padding: 20px;

    }

    h1 {

        font-size: 27px;

    }

    h2 {

        font-size: 22px;

    }

    p {

        font-size: 16px;

    }

    button {

        font-size: 14px;

        padding:
            12px 18px;

    }

}

</style>
</head>


