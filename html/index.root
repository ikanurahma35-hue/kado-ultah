<script>

/* =====================================================
   SLIDE SYSTEM
===================================================== */

let currentSlide = 0;

const slides =
    document.querySelectorAll(".slide");

const progress =
    document.getElementById("progress");


/*
   Buat titik progress
*/

for (
    let i = 0;
    i < slides.length;
    i++
) {

    const dot =
        document.createElement("div");

    dot.className =
        "dot";

    progress.appendChild(dot);

}


/*
   Update slide
*/

function updateSlide() {

    slides.forEach(
        (slide, index) => {

            slide.classList.toggle(
                "active",
                index === currentSlide
            );

        }
    );


    document
        .querySelectorAll(".dot")
        .forEach(
            (dot, index) => {

                dot.classList.toggle(
                    "active",
                    index === currentSlide
                );

            }
        );

}


/*
   Slide berikutnya
*/

function nextSlide() {

    if (
        currentSlide <
        slides.length - 1
    ) {

        currentSlide++;

        updateSlide();

    }

}



/* =====================================================
   NOMOR 1
   KAIL TURUN DARI ATAS
   → SAMPAI TOMBOL
   → MENGAIT
   → MENARIK TOMBOL
   → BARU HILANG
===================================================== */

function hookAttack(button) {


    /*
       Kalau sudah pernah kena kail,
       jangan dijalankan lagi.
    */

    if (
        button.dataset.hooked === "true"
    ) {

        return;

    }


    button.dataset.hooked =
        "true";


    const hook =
        document.getElementById("hook");

    const line =
        document.getElementById("hookLine");


    /*
       Ambil posisi tombol
    */

    const rect =
        button.getBoundingClientRect();


    const centerX =
        rect.left +
        (rect.width / 2);


    /*
       Tampilkan kail
    */

    hook.style.display =
        "block";

    hook.style.left =
        centerX + "px";

    hook.style.top =
        "-80px";


    /*
       Tampilkan benang
    */

    line.style.display =
        "block";

    line.style.left =
        centerX + "px";

    line.style.top =
        "0px";

    line.style.height =
        "0px";


    /*
       ==============================
       TAHAP 1
       KAIL TURUN DARI ATAS
       ==============================
    */

    setTimeout(() => {

        hook.style.top =
            (rect.top - 55) + "px";


        line.style.height =
            Math.max(
                0,
                rect.top - 20
            ) + "px";

    }, 100);



    /*
       ==============================
       TAHAP 2
       KAIL SUDAH SAMPAI
       ==============================
    */

    setTimeout(() => {

        button.classList.add(
            "hooked"
        );


        /*
           Pastikan posisi tombol
           tetap sama ketika dikail
        */

        button.style.left =
            rect.left + "px";

        button.style.top =
            rect.top + "px";


    }, 900);



    /*
       ==============================
       TAHAP 3
       KAIL MENARIK TOMBOL
       ==============================
    */

    setTimeout(() => {

        /*
           Kail naik lagi
        */

        hook.style.top =
            "-100px";


        /*
           Benang ikut naik
        */

        line.style.height =
            "0px";


        /*
           TOMBOL IKUT DITARIK KE ATAS
        */

        button.style.top =
            "-180px";


        button.style.transform =
            "rotate(-20deg) scale(.9)";


    }, 1200);



    /*
       ==============================
       TAHAP 4
       SETELAH KETARIK BARU HILANG
       ==============================
    */

    setTimeout(() => {

        button.style.display =
            "none";

        hook.style.display =
            "none";

        line.style.display =
            "none";

    }, 2500);

}



/* =====================================================
   NOMOR 2
   KEDUA JAWABAN SALAH
   PINDAH RANDOM
   TIDAK PERNAH HILANG
===================================================== */

function runAway(button) {


    /*
       Jarak minimum dari tepi layar
    */

    const margin = 15;


    /*
       Ukuran layar
    */

    const screenWidth =
        document.documentElement.clientWidth;

    const screenHeight =
        document.documentElement.clientHeight;


    /*
       Ukuran tombol
    */

    const buttonWidth =
        button.offsetWidth;

    const buttonHeight =
        button.offsetHeight;


    /*
       Batas maksimum posisi X
    */

    const maxX =
        Math.max(
            margin,
            screenWidth -
            buttonWidth -
            margin
        );


    /*
       Batas maksimum posisi Y
    */

    const maxY =
        Math.max(
            margin,
            screenHeight -
            buttonHeight -
            margin
        );


    /*
       POSISI RANDOM X
    */

    const randomX =
        Math.floor(
            Math.random() *
            (maxX - margin + 1)
        ) + margin;


    /*
       POSISI RANDOM Y
    */

    const randomY =
        Math.floor(
            Math.random() *
            (maxY - margin + 1)
        ) + margin;


    /*
       PINDAHKAN TOMBOL
    */

    button.style.position =
        "fixed";

    button.style.left =
        randomX + "px";

    button.style.top =
        randomY + "px";


    /*
       Sedikit miring random
    */

    const rotation =
        Math.floor(
            Math.random() * 21
        ) - 10;


    button.style.transform =
        `rotate(${rotation}deg)`;


    /*
       ==========================
       PALING PENTING:
       TOMBOL TETAP ADA
       ==========================
    */

    button.style.display =
        "block";

}



/* =====================================================
   NOMOR 3
   API BANYAK
   → MEMBAKAR TOMBOL
   → TOMBOL HILANG
===================================================== */

function burnButton(button) {


    /*
       Jangan jalankan dua kali
    */

    if (
        button.dataset.burning === "true"
    ) {

        return;

    }


    button.dataset.burning =
        "true";


    const fire =
        document.getElementById("fire");


    /*
       Ambil posisi tombol
    */

    const rect =
        button.getBoundingClientRect();


    /*
       Api berada di sekitar tombol
    */

    fire.style.left =
        (
            rect.left +
            rect.width / 2
        ) + "px";


    fire.style.top =
        (
            rect.top +
            rect.height / 2
        ) + "px";


    /*
       Tampilkan api
    */

    fire.style.display =
        "block";


    fire.classList.add(
        "active"
    );


    /*
       Tombol mulai terbakar
    */

    button.classList.add(
        "burning"
    );


    /*
       Setelah api membakar
       tombol mulai mengecil
    */

    setTimeout(() => {

        button.style.opacity =
            "0";

        button.style.transform =
            "scale(.5) rotate(20deg)";

    }, 650);



    /*
       Setelah benar-benar terbakar,
       tombol HILANG
    */

    setTimeout(() => {

        button.style.display =
            "none";


        button.classList.remove(
            "burning"
        );


        fire.classList.remove(
            "active"
        );


        fire.style.display =
            "none";


    }, 1000);

}



/* =====================================================
   MUSIC
===================================================== */

const music =
    document.getElementById("music");


function toggleMusic() {

    if (
        music.paused
    ) {

        music.play();

    } else {

        music.pause();

    }

}



/* =====================================================
   START
===================================================== */

updateSlide();

</script>

</body>
</html>
